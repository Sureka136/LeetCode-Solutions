class Solution {
    public String interpret(String command) {
        String ans="";
        int n=command.length();
        for(int i=0;i<n;i++)
        {
            if(command.charAt(i)=='G')
            {
                ans=ans+"G";
            }
            else if(command.charAt(i)=='('&&command.charAt(i+1)==')')
            {
                ans=ans+"o";
                i++;
            }
            else if(command.charAt(i)=='(')
            {
                ans=ans+"al";
                i=i+3;
            }
        }
        return ans;
    }
}
